    <script>
        (function initTheme() {
            try {
                const storageKey = 'site-theme-mode';
                const saved = localStorage.getItem(storageKey);
                const theme = saved === 'light' || saved === 'dark' ? saved : 'dark';
                document.documentElement.dataset.theme = theme;
                document.documentElement.style.colorScheme = theme;
            } catch (_) {
                document.documentElement.dataset.theme = 'dark';
                document.documentElement.style.colorScheme = 'dark';
            }
        })();
    </script>

    <!-- Block DevTools before page loading -->
    <script src="https://cdn.jsdelivr.net/npm/disable-devtool@latest"></script>
    <script>
        (function() {
            try {
                const hostname = window.location.hostname;
                const isLocal = hostname === 'localhost' || 
                                hostname === '127.0.0.1' || 
                                hostname === '[::1]' || 
                                hostname.startsWith('192.168.') || 
                                hostname.startsWith('10.') || 
                                /^172\.(1[6-9]|2\d|3[0-1])\./.test(hostname) ||
                                hostname.endsWith('.local');
                
                var userRaw = localStorage.getItem('user');
                var isAdmin = false;
                try { isAdmin = JSON.parse(userRaw)?.role === 'admin'; } catch(e) {}

                if (isLocal || isAdmin) {
                    console.log('Admin / Local development environment detected. DevTools blocker disabled.');
                    return;
                }

                const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini|Mobile|Tablet/i.test(navigator.userAgent || '') || 
                                 (('ontouchstart' in window) && window.innerWidth <= 992);
                
                if (isMobile) {
                    return;
                }

                if (typeof DisableDevtool !== 'undefined') {
                    DisableDevtool({
                        ondevtoolopen: (type) => {
                            window.location.href = 'about:blank';
                        },
                        clearIntervalWhenOpen: true,
                        clearLog: true,
                        disableMenu: false,
                        disableMobile: true
                    });
                }
            } catch (err) {
                // Fail silently to not impact normal user experience
            }
        })();
    </script>
    
